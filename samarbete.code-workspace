{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "task.autoDetect": "on",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "git.autofetch": true,
    "git.autofetchPeriod": 60
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🚀 Auto: Pull vid öppning",
        "type": "shell",
        "command": "source .session-start.sh",
        "problemMatcher": [],
        "runOptions": {
          "runOn": "folderOpen"
        },
        "presentation": {
          "reveal": "never",
          "panel": "shared"
        }
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "eamodio.gitlens"
    ]
  }
}
