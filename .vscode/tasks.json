{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Session Start - Pull from GitHub",
      "type": "shell",
      "command": "source .session-start.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": false
    },
    {
      "label": "💾 Session End - Save Changes",
      "type": "shell",
      "command": "./.session-end.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📥 Pull from GitHub",
      "type": "shell",
      "command": "./sync.sh pull",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📤 Push to GitHub",
      "type": "shell",
      "command": "./sync.sh push",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🔄 Sync (Pull + Push)",
      "type": "shell",
      "command": "./sync.sh sync",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
